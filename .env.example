# Optional overrides. Phase 1 runs with the defaults below.
# Copy this file to .env only if you need to change them.

# DATA_DIR=C:\path\to\clipper-data
# CLIPPER_MODEL_CACHE=C:\path\to\clipper-data\models

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
WHISPER_VAD_FILTER=true
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=4
MAX_UPLOAD_BYTES=4294967296

OLLAMA_HOST=http://localhost:11434
# Preferred model name. If this one is not installed, Clipper uses another model from `ollama list`.
# You can also choose the model in Settings.
OLLAMA_MODEL=qwen2.5:3b

# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
